{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "rootDir": "nico-src",
    "outDir": ".generated/nico",
    "declaration": true,
    "sourceMap": false
  },
  "include": [
    "nico-src/**/*.ts"
  ],
  "exclude": [
    "nico-src/CapTubeEntry.ts",
    "nico-src/CommentPanel.ts",
    "nico-src/GamePadEntry.ts",
    "nico-src/MaskedWatchEntry.ts",
    "nico-src/NicoVideoPlayer.ts",
    "nico-src/NicoVideoPlayerDialog.ts",
    "nico-src/ScreenFilter.ts",
    "nico-src/StoryboardWorker.ts",
    "nico-src/SupporterCredit.ts",
    "nico-src/VideoInfoPanel.ts"
  ]
}
