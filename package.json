{
  "name": "ZenzaWatch",
  "description": "niconico HTML5 Player",
  "version": "0.0.0",
  "author": "segabito",
  "bugs": {
    "url": "https://github.com/ButaMonky/ZenzaWatch/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@babel/preset-env": "^7.4.5",
    "@babel/register": "^7.0.0-beta.42",
    "cross-env": "^10.1.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "globals": "13.24.0",
    "jquery": "^3.3.1",
    "jsdom": "^30.0.1",
    "lit": "^2.0.2",
    "lodash": "4.18.1",
    "mocha": "^3.5.3",
    "mock-local-storage": "^1.0.5",
    "node-notifier": "^5.4.0",
    "power-assert": "^1.4.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "directories": {
    "test": "test/"
  },
  "files": [
    "README.MD",
    "package.json",
    "lib",
    "test"
  ],
  "homepage": "https://github.com/ButaMonky/ZenzaWatch",
  "keywords": [
    "ES6",
    "test"
  ],
  "license": "MIT-0",
  "main": "src/ZenzaWatchIndex.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ButaMonky/ZenzaWatch.git"
  },
  "scripts": {
    "build": "node ./build.js --dev",
    "watch": "node ./build.js --dev --watch",
    "pretest": "node tools/check-root-test-generated.cjs",
    "test": "cross-env NODE_ENV=test mocha --require ./test/setup.js test/**/unit/*.js",
    "lint:syntax": "eslint --no-eslintrc --env es2022,node,browser --parser-options \"sourceType: module\" --ext .js ./src ./packages",
    "build:production": "node ./build.js",
    "build:monkey": "node ./build.js --dev",
    "watch:monkey": "node ./build.js --dev --watch",
    "test:external": "node --test packages/external-playback/*.test.cjs",
    "test:external:browser": "node packages/external-playback/background-browser.cjs"
  }
}
