{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "rootDir": "p12-src",
    "outDir": ".generated/p12",
    "types": [],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "p12-src/*.ts"
  ]
}
